;; See https://github.com/juxt/aero and https://biffweb.com/docs/api/utilities/#use-aero-config.
;; #biff/env and #biff/secret will load values from the environment and from config.env.
{;; PORT (env or config.env) moves the dev server off 8080, so each git worktree
 ;; can run its own. Set NREPL_PORT alongside it; `just e2e-*` reads PORT too.
 :biff/base-url #profile {:prod    #join ["https://" #biff/env DOMAIN]
                          :default #join ["http://localhost:" #or [#biff/env PORT "8080"]]}
 :biff/host     #profile {:dev     "0.0.0.0"
                          :prod    #or [#biff/env HOST "localhost"]
                          :default "localhost"}
 :biff/port     #profile {:dev  #long #or [#biff/env PORT 8080]
                          :prod #long #or [#biff/env PORT 8080]}

 :biff.xtdb/dir          "storage/xtdb"
 :biff.xtdb/topology     #keyword #or [#profile {:prod    #biff/env "PROD_XTDB_TOPOLOGY"
                                                 :default #biff/env "XTDB_TOPOLOGY"}
                                       "standalone"]
 :biff.xtdb.jdbc/jdbcUrl #biff/secret "XTDB_JDBC_URL"

 ;; HikariCP 3.4.5 pool settings for Neon Postgres (which suspends idle connections)
 :biff.xtdb.jdbc-pool/maxLifetime       #profile {:prod 300000 :default nil} ; 5 min — rotate before Neon suspends
 :biff.xtdb.jdbc-pool/idleTimeout       #profile {:prod 120000 :default nil} ; 2 min — evict idle connections quickly
 :biff.xtdb.jdbc-pool/maximumPoolSize   #profile {:prod 5      :default nil} ; smaller pool for Neon
 :biff.xtdb.jdbc-pool/minimumIdle       #profile {:prod 1      :default nil} ; allow pool to shrink when idle
 :biff.xtdb.jdbc-pool/connectionTimeout #profile {:prod 20000  :default nil} ; 20s timeout to acquire connection

 :biff.beholder/enabled         #profile {:dev true :default false}
 :biff.middleware/secure        #profile {:dev false :default true}
 :biff.middleware/cookie-secret #biff/secret COOKIE_SECRET
 :biff/jwt-secret               #biff/secret JWT_SECRET
 :biff.refresh/enabled          #profile {:dev true :default false}

 :mailersend/api-key  #profile {:prod    #biff/secret MAILERSEND_API_KEY
                                :dev     nil
                                :default nil}
 :mailersend/from     #biff/env MAILERSEND_FROM
 :mailersend/reply-to #biff/env MAILERSEND_REPLY_TO

 :recaptcha/secret-key #biff/secret RECAPTCHA_SECRET_KEY
 :recaptcha/site-key   #biff/env RECAPTCHA_SITE_KEY

 ;; Base64 32-byte AES key for credentials stored in XTDB (Cronometer). Each
 ;; environment has its own; generate with `openssl rand -base64 32`. Absent,
 ;; the Cronometer connect form is disabled and its sync stays dormant.
 :gleanmo/credentials-key #biff/secret CREDENTIALS_KEY

 ;; Dev only: the Cronometer sync targets the fake API served by
 ;; dev/tech/jgood/gleanmo/fake_cronometer.clj on this server instead of
 ;; mobile.cronometer.com. Hard false in prod, whatever the env says.
 :gleanmo.cronometer/fake #profile {:prod    false
                                    :default #boolean #biff/env FAKE_CRONOMETER}

 ;; Dev only: the shared secret the e2e sign-in routes require
 ;; (dev/tech/jgood/gleanmo/e2e_auth.clj). Unset means those routes refuse.
 :gleanmo.e2e/login-token #profile {:dev     #biff/env E2E_LOGIN_TOKEN
                                    :default nil}

 :biff.nrepl/enabled #profile {:dev true :default false}
 :biff.nrepl/port    #or [#biff/env NREPL_PORT "7888"]
 :biff.nrepl/args    ["--port" #ref [:biff.nrepl/port]
                      "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]

 :biff.system-properties/user.timezone                 "UTC"
 :biff.system-properties/clojure.tools.logging.factory "clojure.tools.logging.impl/slf4j-factory"

 :biff.tasks/server                 #biff/env DOMAIN
 :biff.tasks/main-ns                tech.jgood.gleanmo
 :biff.tasks/on-soft-deploy         "\"(tech.jgood.gleanmo/on-save @tech.jgood.gleanmo/system)\""
 :biff.tasks/generate-assets-fn     tech.jgood.gleanmo/generate-assets!
 :biff.tasks/css-output             "target/resources/public/css/main.css"
 :biff.tasks/deploy-untracked-files [#ref [:biff.tasks/css-output]
                                     "config.env"]

 :biff.tasks/deploy-cmd ["git" "push" "prod" "main:master"]
 ;; Uncomment this line if you have any ssh-related problems:
 ;; :biff.tasks/skip-ssh-agent true
 }
